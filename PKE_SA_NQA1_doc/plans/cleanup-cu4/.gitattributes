# Keep verification receipts byte-stable across Windows/Linux checkouts.
*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.jsonl -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.xml -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.zip -text
