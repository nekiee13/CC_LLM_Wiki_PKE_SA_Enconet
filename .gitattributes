# Line-ending policy (Task C0.2): normalize text to LF in the repository;
# working-tree endings follow each machine's git configuration.
* text=auto

# Always-LF for cross-platform tooling
*.sh text eol=lf

# Never normalize binary evidence formats
*.pdf binary
*.png binary
*.jpg binary
*.xlsx binary
*.db binary

# Verbatim source evidence and byte-preserving extraction may legitimately carry
# source trailing spaces; do not classify those bytes as authored-code whitespace errors.
Enconet/raw/** whitespace=-blank-at-eol,-blank-at-eof
Enconet/derived/** whitespace=-blank-at-eol,-blank-at-eof
# Published hash-manifested release bytes must survive checkout unchanged.
Enconet/outputs/enconet_appendix_b_evaluation_package.json -text
Enconet/outputs/enconet_appendix_b_evaluation_report.md -text
Enconet/outputs/enconet_appendix_b_dashboard_data.json -text
Enconet/outputs/enconet_appendix_b_dashboard.html -text
Enconet/wiki/dashboards/enconet_appendix_b_dashboard.html -text
Enconet/outputs/candidates/evidence_access/portable_package/** -text
# Captured native Windows ACL JSON keeps CRLF; CR is not trailing whitespace.
Enconet/out/2026-10-10/release-acl-repair/*.json whitespace=cr-at-eol
# Native Windows builder receipt is preserved byte-exact alongside its HTML.
Enconet/outputs/candidates/evidence_access/RUN-20261008-17/dark/*.provenance.json whitespace=cr-at-eol
