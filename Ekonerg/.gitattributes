# Keep copied framework text and its journals byte-stable on every checkout.
# This does not touch source documents in incoming/ or controlled evidence.
.gitattributes text eol=lf
scripts/*.py text eol=lf
sieving/cli.py text eol=lf
sieving/src/**/*.py text eol=lf
sieving/prompts/active.yml text eol=lf
schemas/*.yml text eol=lf
manifests/*.csv text eol=lf
wiki/**/.gitkeep text eol=lf
.bootstrap/**/*.jsonl text eol=lf

# These hash-bound review bundles must survive checkout byte-for-byte.
# They are candidate evidence, not replacements for registered raw sources.
out/2026-10-06/full-keyword-sweep-verified/** -text whitespace=-blank-at-eol,-blank-at-eof
sieving/candidates/manual-full-20261006/** -text whitespace=-blank-at-eol,-blank-at-eof
out/2026-10-06/manual-source-intake-preview.json -text
out/2026-10-06/manual-source-intake/** -text
sieving/runs/RUN-20261006-77/** -text
out/2026-10-06/manual-refresh-preview.json -text
out/2026-10-06/manual-refresh/** -text whitespace=-blank-at-eol,-blank-at-eof
docs/reviews/MANUAL_REFRESH_ASSESSMENT_20261006.json -text
docs/reviews/DOCUMENT_SCORING_ASSESSMENT_20261007.json -text
